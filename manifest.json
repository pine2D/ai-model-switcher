{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "0.19.0",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup/popup.html" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "permissions": ["storage", "tabs", "system.display", "identity", "alarms", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "228744155119-1h2j47hqp2s4tvnjjmd868qglqqo2eae.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.doubao.com/*",
        "https://chat.deepseek.com/*",
        "https://www.qianwen.com/*",
        "https://www.kimi.com/*",
        "https://yuanbao.tencent.com/*",
        "https://chatglm.cn/*"
      ],
      "js": ["i18n.js", "content/core.js", "content/upload.js", "content/md.js", "content/adapters-intl.js", "content/adapters-cn.js", "content/adapters-cn2.js", "content/diag.js", "content/pill.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "switch-think": {
      "suggested_key": { "default": "Alt+T" },
      "description": "__MSG_cmdThink__"
    },
    "switch-fast": {
      "suggested_key": { "default": "Alt+Y" },
      "description": "__MSG_cmdFast__"
    },
    "open-console": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "__MSG_cmdOpenConsole__"
    }
  }
}
