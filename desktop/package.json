{
  "name": "polyask-desktop",
  "version": "1.0.0",
  "productName": "PolyAsk",
  "private": true,
  "description": "PolyAsk cross-platform desktop shell",
  "author": "pine2D",
  "homepage": "https://github.com/pine2D/polyask",
  "main": ".webpack/main",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "configure-oauth": "node scripts/configure-oauth.mjs",
    "collect-release": "node scripts/release-artifacts.mjs",
    "prepare-portable": "node scripts/prepare-portable.mjs",
    "smoke": "node scripts/smoke.mjs",
    "soak": "node scripts/soak.mjs",
    "test": "tsc --noEmit && tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\" && node --test \"scripts/*.test.{js,mjs}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "css-loader": "^7.1.2",
    "electron": "43.4.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "tsx": "4.23.12",
    "typescript": "^5.7.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
